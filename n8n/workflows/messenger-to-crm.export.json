        "path": "chatwoot-sync",
        "responseMode": "lastNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "webhook-trigger",
      "name": "Chatwoot Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -600,
        0
      ],
      "webhookId": "29d7f1e6-1518-4fe1-bdcd-d6f60e7efc86"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = 'SIGNING_SECRET_TU_STEP_1';\nconst timestamp = $input.item.json.headers['x-chatwoot-timestamp'];\nconst rawBody = Buffer.from($input.item.binary.data.data, 'base64').toString('utf8');\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(timestamp + '.' + rawBody).digest('hex');\nconst received = $input.item.json.headers['x-chatwoot-signature'] || '';\n\nconst expectedBuf = Buffer.from(expected);\nconst receivedBuf = Buffer.from(received);\nconst validSignature = expectedBuf.length === receivedBuf.length && crypto.timingSafeEqual(expectedBuf, receivedBuf);\nif (!validSignature) {\n\tthrow new Error('Invalid Chatwoot webhook signature');\n}\n\nconst tsNum = parseInt(timestamp, 10);\nif (!tsNum || Math.abs(Date.now() / 1000 - tsNum) > 300) {\n\tthrow new Error('Chatwoot webhook timestamp missing or too old (possible replay)');\n}\n\nreturn $input.item;\n"
      },
      "id": "verify-signature",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "function normalizePhone(raw) {\n\tconst digits = raw.replace(/[\\s-]/g, '');\n\tif (digits.startsWith('+84')) return digits;\n\tif (digits.startsWith('0')) return '+84' + digits.slice(1);\n\treturn digits;\n}\n\nfunction buildLeadSearchFilters({ email, phone }) {\n\tconst conditions = [];\n\tif (email) conditions.push(['CRM Lead', 'email', '=', email]);\n\tif (phone) conditions.push(['CRM Lead', 'mobile_no', '=', normalizePhone(phone)]);\n\treturn conditions.length ? conditions : null;\n}\n\nfunction buildNewLeadPayload({ source, name, email, phone, chatwootContactId }) {\n\treturn {\n\t\tsource,\n\t\tfirst_name: name || 'Unknown',\n\t\tlead_name: name,\n\t\temail,\n\t\tmobile_no: normalizePhone(phone),\n\t\tchatwoot_contact_id: chatwootContactId,\n\t};\n}\n\n// Chatwoot's conversation_created payload is NOT wrapped in a \"conversation\" key --\n// conversation.webhook_data.merge(event: ...) puts id/channel/meta at the top level.\nconst body = $input.item.json.body;\nif (body.event !== 'conversation_created') {\n\tthrow new Error(`Unsupported Chatwoot event: ${body.event}`);\n}\n\nconst contact = body.meta.sender;\nconst conversationId = body.id;\nconst email = contact.email || '';\nconst phone = contact.phone_number || '';\nconst payload = buildNewLeadPayload({\n\tsource: (body.channel || '').includes('Instagram') ? 'Instagram' : 'Messenger',\n\tname: contact.name,\n\temail,\n\tphone,\n\tchatwootContactId: String(contact.id),\n});\nconst searchFilters = buildLeadSearchFilters({ email, phone });\n\nreturn { json: { contact, payload, searchFilters, conversationId } };\n"
      },
      "id": "build-lead-payload",
      "name": "Build Lead Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        0
      ]
    },
