{
  "name": "messenger-to-crm",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chatwoot-sync",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Chatwoot Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -400,
        0
      ],
      "webhookId": "b3d122d6-244b-44a7-913f-12db1b8feb55"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = 'SIGNING_SECRET_TU_STEP_1';\nconst rawBody = JSON.stringify($input.item.json.body ?? $input.item.json);\nconst expected = crypto.createHmac('sha256', secret).update(rawBody).digest('hex');\nconst received = $input.item.json.headers['x-chatwoot-signature'];\n\nif (expected !== received) {\n\tthrow new Error('Invalid Chatwoot webhook signature');\n}\n\nreturn $input.item;\n"
      },
      "id": "verify-signature",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "function normalizePhone(raw) {\n\tconst digits = raw.replace(/[\\s-]/g, '');\n\tif (digits.startsWith('+84')) return digits;\n\tif (digits.startsWith('0')) return '+84' + digits.slice(1);\n\treturn digits;\n}\n\nfunction buildLeadSearchFilters({ email, phone }) {\n\treturn [\n\t\t['CRM Lead', 'email', '=', email],\n\t\t['CRM Lead', 'mobile_no', '=', normalizePhone(phone)],\n\t];\n}\n\nfunction buildNewLeadPayload({ source, name, email, phone, chatwootContactId }) {\n\treturn {\n\t\tsource,\n\t\tlead_name: name,\n\t\temail,\n\t\tmobile_no: normalizePhone(phone),\n\t\tchatwoot_contact_id: chatwootContactId,\n\t};\n}\n\nconst contact = $input.item.json.body.conversation.meta.sender;\nconst conversationId = $input.item.json.body.conversation.id;\nconst email = contact.email || '';\nconst phone = contact.phone_number || '';\nconst payload = buildNewLeadPayload({\n\tsource: $input.item.json.body.conversation.channel.includes('Instagram') ? 'Instagram' : 'Messenger',\n\tname: contact.name,\n\temail,\n\tphone,\n\tchatwootContactId: String(contact.id),\n});\nconst searchFilters = buildLeadSearchFilters({ email, phone });\n\nreturn { json: { contact, payload, searchFilters, conversationId } };\n"
      },
      "id": "build-lead-payload",
      "name": "Build Lead Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.contact.custom_attributes.crm_lead_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-already-mapped",
      "name": "Already mapped to a Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://crm.example.com/api/resource/CRM Lead",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filters",
              "value": "={{ JSON.stringify($json.searchFilters) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "search-existing-lead",
      "name": "Search Existing Lead",
