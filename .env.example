# ──────────────────────────────────────────────────────────────────
# DX-OSD Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env — it's in .gitignore
# ──────────────────────────────────────────────────────────────────

# ── Facebook Page ─────────────────────────────────────────────────
# Get from: Graph API Explorer → Select Page → Generate Token
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=

# ── Chatwoot ──────────────────────────────────────────────────────
CHATWOOT_BASE_URL=http://127.0.0.1:3000
CHATWOOT_BOT_API_TOKEN=
CHATWOOT_USER_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_WEBHOOK_SECRET=

# ── Cloudflare Tunnel ─────────────────────────────────────────────
# Quick tunnel URL changes each restart; fixed tunnel needs auth
CLOUDFLARE_TUNNEL_URL=

# ── Gemini / Google AI Studio ────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── 9Router AI (caption generation) ──────────────────────────────
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_MODEL=ag/gemini-3.7-flash-low

# ── TypeSafe Jev (optional AI intelligence) ──────────────────────
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest

# ── Frappe CRM ────────────────────────────────────────────────────
CRM_URL=http://127.0.0.1:8000
CRM_SITE=crm.localhost

# ── Auto-Post Schedule ───────────────────────────────────────────
# Cron expression for auto-posting (default: 8am daily)
AUTO_POST_CRON=0 8 * * *
# Comma-separated course topics to rotate
AUTO_POST_TOPICS=Tiếng Anh,Bơi lội,Toán tư duy
